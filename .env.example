# Backend (agile-space-backend) — URLs públicas usadas pelo browser.
# Em produção, apontar para o domínio público real do backend (atrás do reverse proxy/TLS).
NEXT_PUBLIC_API_URL=http://localhost:8002/api
NEXT_PUBLIC_SPRING_API_URL=http://localhost:8002/api

# Chave X-Api-Key usada pelas rotas server-side do Next.js (src/app/api/v1/**) para chamar
# o backend com escopo de API key em vez de JWT de sessão — gerar via POST /api/admin/api-keys
# no backend (ver DEPLOYMENT.md do agile-space-backend).
AGILE_SPACE_API_KEY=

# Integração com Jira (proxy server-side em src/app/api/jira/**)
JIRA_BASE=
JIRA_DEFAULT_DOMAIN=
# true só deve ser usado em dev local; em produção manter false e confiar na truststore da JVM/CA corporativa.
JIRA_TLS_INSECURE=false

# IA — chat/assistente (src/app/api/ai/chat/route.ts usa a Lynn, gateway interno da TOTVS)
LYNN_API_KEY=
LYNN_BASE_URL=
LYNN_MODEL=lynn

# IA — provedores usados em outras features (Gemini)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=

# OAuth Client ID (tipo "Aplicativo da Web") para o botão "Conectar minha agenda"
# do card "Próxima cerimônia" (/painel). Criar no Google Cloud Console com o app
# marcado como INTERNO no Workspace da TOTVS (dispensa verificação do escopo de
# calendário) e autorizar as origens http://localhost:9002 e a de produção.
# Sem essa variável o card fica oculto — não é obrigatória pra rodar o resto do app.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Observabilidade (OpenTelemetry, ver src/instrumentation.ts) — vendor-neutro, compatível com
# SigNoz ou qualquer outro backend OTLP. Roda no servidor Node (não é NEXT_PUBLIC_, não precisa
# ser build arg). Sem OTEL_EXPORTER_OTLP_ENDPOINT, fica inerte.
OTEL_SERVICE_NAME=agile-space-frontend
OTEL_EXPORTER_OTLP_ENDPOINT=
